# ---------- Site ----------
# Marketing site and app host. In production: https://funcoinlab.com and https://app.funcoinlab.com.
# When both are the same (or on any other host, like localhost or *.vercel.app), one host serves everything.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# ---------- AI (server-only — never exposed to the browser) ----------
# anthropic | openai | local   (defaults to anthropic when AI_API_KEY is set, else local templates)
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional model override. Anthropic default: claude-opus-5-5. OpenAI default: gpt-4o-mini
AI_MODEL=
# Optional, OpenAI-compatible endpoints only
AI_BASE_URL=

# ---------- AI images (logos, mascot poses, memes, banners) ----------
# openai | none. The key is server-only. IMAGE_API_KEY overrides OPENAI_API_KEY if both are set.
IMAGE_PROVIDER=none
OPENAI_API_KEY=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
# low | medium | high | auto (cost scales with quality)
IMAGE_QUALITY=medium
# Site-wide safety cap on AI images per day (images are paid with credits).
IMAGE_GLOBAL_DAILY_LIMIT=300

# ---------- Wallet sign-in & credits ----------
# Required in production: 32+ random characters. Signs the wallet session cookie.
SESSION_SECRET=
# mainnet-beta | devnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# A dedicated RPC (Helius, Triton, QuickNode...) is strongly recommended; the public one is rate-limited.
# Not needed: the browser uses /api/solana/rpc, which forwards to SOLANA_RPC_URL (keeps the API key private).
# NEXT_PUBLIC_SOLANA_RPC_URL=
SOLANA_RPC_URL=
# Your wallet that receives SOL/USDC payments. Leave empty to turn wallet payments off.
# For USDC, make sure this wallet already has a USDC token account.
MERCHANT_SOLANA_ADDRESS=

# Optional: WalletConnect (connect a phone wallet by QR code). Free project ID from https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# NOWPayments (pay with 100+ coins). Both values come from your NOWPayments dashboard.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# ---------- Supabase (projects, websites, images, credits) ----------
# Required. Accounts are Solana wallets; the server reads and writes all data with the service role.
SUPABASE_URL=
# Server-only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Domain availability ----------
# none (default, never claims availability) | dynadot | rdap (public registry lookup) | http (your registrar API)
DOMAIN_PROVIDER=none
# Dynadot: API key from Account > Tools > API (allow your server's IP there if Dynadot asks you to).
DYNADOT_API_KEY=
# true = use api-sandbox.dynadot.com
DYNADOT_SANDBOX=false
# Generic registrar API (DOMAIN_PROVIDER=http)
DOMAIN_API_URL=
DOMAIN_API_KEY=
# Your Dynadot affiliate link, with {domain} where the domain name goes (copy the format from your affiliate dashboard).
# Every "Get it on Dynadot" button goes through /go/domain (click tracking), then here.
NEXT_PUBLIC_DOMAIN_AFFILIATE_URL_TEMPLATE=
# Fallback search link when no affiliate template is set, and the registrar's display name.
NEXT_PUBLIC_REGISTRAR_SEARCH_URL=https://www.dynadot.com/domain/search?domain={domain}
NEXT_PUBLIC_REGISTRAR_NAME=Dynadot

# ---------- Default community links on generated sites (optional) ----------
NEXT_PUBLIC_DEFAULT_X_URL=
NEXT_PUBLIC_DEFAULT_TELEGRAM_URL=
NEXT_PUBLIC_DEFAULT_DISCORD_URL=

# ---------- Official FunCoin Lab channels and token (public, shown on the site) ----------
# Full https URLs. Leave empty to hide. GitHub defaults to the public repo.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# Token. The site switches from "coming soon" to "live" once NEXT_PUBLIC_TOKEN_CA is a valid Solana address.
NEXT_PUBLIC_TOKEN_NAME="FunCoin Lab"
NEXT_PUBLIC_TOKEN_TICKER=FUNLAB
NEXT_PUBLIC_TOKEN_CA=
# Optional overrides. pump.fun, DexScreener and Solscan links are built from the CA automatically.
NEXT_PUBLIC_PUMPFUN_URL=
NEXT_PUBLIC_DEX_URL=
NEXT_PUBLIC_JUPITER_URL=
NEXT_PUBLIC_COINGECKO_URL=
NEXT_PUBLIC_CMC_URL=

# ---------- Admin panel (admin.funcoinlab.com) ----------
# Server-only. The admin host is never exposed to the browser bundle.
ADMIN_URL=
# Comma-separated Solana addresses. These wallets are owners and can't be removed from the UI.
ADMIN_WALLETS=
# 32+ random characters. Signs the 8-hour step-up admin cookie (separate from SESSION_SECRET).
ADMIN_SESSION_SECRET=
# Optional: comma-separated IPs allowed to use the admin panel.
ADMIN_IP_ALLOWLIST=
